# Copy to .env.local. All values are server-side only (never NEXT_PUBLIC_).
API_URL=http://localhost:4000
# Same value as API_KEY in backend/.env
API_KEY=CHANGE_ME

# DEV ONLY. Set to 1 to show made-up sample rows (lib/sample-data.ts) instead of calling the API.
# Off by default. Production builds ignore it.
OPENROLES_SAMPLE_DATA=0
