# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://openroles:CHANGE_ME@localhost:5432/openroles?schema=public
DATABASE_URL_TEST=postgresql://openroles:CHANGE_ME@localhost:5432/openroles_test?schema=public
PORT=4000
# Long random secret shared with the frontend: openssl rand -hex 32
API_KEY=CHANGE_ME
FRONTEND_ORIGIN=http://localhost:3000
TARGET_COUNTRIES=IN,AE,US
MAX_JOB_AGE_DAYS=30
RETENTION_DAYS=90
RUN_DEADLINE_MINUTES=90
MAX_BOARDS_PER_RUN=5000
MAX_COMPANY_PROBES=100
# LinkedIn logged-out job search (approved 25 Nov 2026). Set false to switch it off.
LINKEDIN_ENABLED=true
LINKEDIN_MAX_REQUESTS=300
# The API runs the fetch every day at 06:00 IST. Set true to switch that off on this server.
DISABLE_CRONS=false
SLACK_WEBHOOK_URL=
