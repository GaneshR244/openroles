<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OpenRoles daily fetch at 06:00 local time on a Mac (launchd), until a server exists.
  If the Mac is asleep at 06:00, macOS runs it once when it wakes.
  Install and remove: see "Daily schedule on this Mac" in the root README.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openroles.fetch-jobs</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ganesh/.nvm/versions/node/v22.23.4/bin/node</string>
    <string>dist/scripts/fetch-jobs.js</string>
    <string>--trigger=cron</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ganesh/projects/openroles/backend</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ganesh/projects/openroles/backend/logs/fetch-jobs.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ganesh/projects/openroles/backend/logs/fetch-jobs.log</string>
</dict>
</plist>
